{
  "id": "secretshare",
  "realm": "secretshare",
  "displayName": "SecretShare",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "clients": [
    {
      "clientId": "secretshare-api",
      "name": "SecretShare API",
      "description": "SecretShare API Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "secretshare-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "secretshare-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "http://app.localhost/*",
        "http://app.localhost:*/*",
        "http://staging-server/*",
        "http://staging-server:*/*",
        "http://*.staging-server/*",
        "http://*.staging-server:*/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://127.0.0.1",
        "http://app.localhost",
        "http://staging-server",
        "http://*.staging-server"
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "test@example.com",
      "firstName": "Test",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpassword123",
          "temporary": false
        }
      ]
    }
  ]
}
