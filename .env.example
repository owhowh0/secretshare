# Generate a secure password, e.g.: openssl rand -hex 24
POSTGRES_USER=secretshare
POSTGRES_DB=secretshare
POSTGRES_PASSWORD=replace_with_a_secure_random_password

# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_secure_random_password
KEYCLOAK_REALM=secretshare
KEYCLOAK_CLIENT_ID=secretshare-api

# Needed to run the API, Alembic or the DB-backed tests from the host.
# Inside docker compose these are injected by the api service.
# Leaving DATABASE_URL unset disables audit logging silently — the API still
# serves secrets, but no audit row is ever written.
DATABASE_URL=postgresql+asyncpg://secretshare:<password>@127.0.0.1:5432/secretshare

# Set these to run the security suites; without them the DB and Redis tests
# skip and the run reports green without testing anything.
TEST_DATABASE_URL=postgresql+asyncpg://secretshare:<password>@127.0.0.1:5432/secretshare
TEST_REDIS_URL=redis://127.0.0.1:6379/0

# Audit logging. Set to false only for local debugging, never in a deployment.
AUDIT_ENABLED=true

# Max ciphertext bytes accepted by POST /secrets (CLAUDE.md §7: 64 KB).
MAX_PAYLOAD_BYTES=65536
