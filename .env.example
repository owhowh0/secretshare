# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Generate a secure password, e.g.: openssl rand -hex 24
POSTGRES_USER=secretshare
POSTGRES_PASSWORD=replace_with_a_secure_random_password
POSTGRES_DB=secretshare
POSTGRES_PORT=5432
DB_HOST=db

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Keycloak Configuration (Pre-provisioned in keycloak/realm-export.json)
# Note: If changing realm or client ID, also update keycloak/realm-export.json
# ==============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_secure_keycloak_admin_password
KEYCLOAK_DB=keycloak
KEYCLOAK_REALM=secretshare
KEYCLOAK_CLIENT_ID=secretshare-api
KEYCLOAK_URL=http://keycloak:8080/keycloak
KEYCLOAK_PATH=/keycloak

# ==============================================================================
# Automated Test User (Pre-provisioned in keycloak/realm-export.json)
# Note: Matching test credentials defined in realm-export.json
# ==============================================================================
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=testpassword123
TEST_USER_EMAIL=test@example.com

# ==============================================================================
# Traefik & Domain Routing (Optional)
# ==============================================================================
TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
APP_HOST=app.localhost
API_HOST_LOCAL=api.localhost
API_HOST_STAGING=api.staging-server
