# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Generate a secure password, e.g.: openssl rand -hex 24
POSTGRES_USER=secretshare
POSTGRES_PASSWORD=replace_with_a_secure_random_password
POSTGRES_DB=secretshare
POSTGRES_PORT=5432
DB_HOST=db

# Needed to run the API, Alembic or the DB-backed tests from the host.
# Inside docker compose these are injected by the api service.
# Leaving DATABASE_URL unset disables audit logging silently — the API still
# serves secrets, but no audit row is ever written.
DATABASE_URL=postgresql+asyncpg://secretshare:<password>@127.0.0.1:5432/secretshare
TEST_DATABASE_URL=postgresql+asyncpg://secretshare:<password>@127.0.0.1:5432/secretshare

# ==============================================================================
# Redis Configuration
# ==============================================================================
# Cache and one-time secret storage backend
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/0

# ==============================================================================
# Keycloak Configuration (Pre-provisioned in keycloak/realm-export.json)
# ==============================================================================
# Admin credentials for Keycloak Administration Console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_secure_random_password
KEYCLOAK_DB=keycloak

# Realm and Client credentials
KEYCLOAK_REALM=secretshare
KEYCLOAK_CLIENT_ID=secretshare-api
KEYCLOAK_URL=http://keycloak:8080/keycloak
KEYCLOAK_PATH=/keycloak

# ==============================================================================
# FastAPI Configuration
# ==============================================================================
# Root path prefix for FastAPI docs, OpenAPI spec, and reverse proxy routing
# Local default: /api | Preview default: /pr-${PR_NUMBER}/api
API_ROOT_PATH=/api

# development | testing | production. production fails fast at startup when
# DATABASE_URL or the KEYCLOAK_* settings are missing.
ENVIRONMENT=development

# Audit logging. Set to false only for local debugging, never in a deployment.
AUDIT_ENABLED=true

# Max ciphertext bytes accepted by POST /secrets (CLAUDE.md §7: 64 KB).
MAX_PAYLOAD_BYTES=65536

# Seconds before an unread secret expires on its own.
SECRET_TTL_SECONDS=600

# Per-client-IP rate limits: requests allowed per window.
RATE_LIMIT_WINDOW_SECONDS=60
CREATE_RATE_LIMIT=10
RETRIEVE_RATE_LIMIT=30

# ==============================================================================
# Preview Environment Variables (Ephemeral Staging)
# ==============================================================================
# Injected automatically by GitHub Actions in deploy-preview.yml
# PR_NUMBER=9

# ==============================================================================
# Automated Test Credentials (Pre-provisioned in keycloak/realm-export.json)
# ==============================================================================
# User credentials for running live integration tests and browser login
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=testpassword123
TEST_USER_EMAIL=test@example.com

# Integration test control flags
# When set to 1, live tests fail immediately if Keycloak is unreachable instead of skipping
REQUIRE_KEYCLOAK=1
# Optional live API endpoint target for integration tests (e.g. http://localhost:80/api)
API_BASE_URL=

# ==============================================================================
# Traefik Path-Based Routing Configuration
# ==============================================================================
# Host port bindings for local development
# - Web UI is served at / (root)
# - API is served at /api
# - Keycloak is served at /keycloak
TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
